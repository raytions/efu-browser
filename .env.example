# 环境变量配置示例（配合 docker-compose.env.yml 使用）
# 复制此文件为 .env 并按需修改

# 浏览器监听端口（默认仅绑定 127.0.0.1，建议前置反向代理做认证保护）
EFU_HTTP_BIND=127.0.0.1
EFU_HTTP_PORT=8080

# Scans 页面模式：demo（默认，纯前端模拟）或 real（连接服务器端受控扫描 API）
SCANS_MODE=demo

# real 模式下前端请求的同源扫描 API 前缀（demo 模式不会请求此路径）
SCANS_API_BASE=/api/scans

# 是否允许通过后端 API 触发扫描：true|false（默认 false，后端强校验并返回 403）
SCANS_ALLOW_TRIGGER=false

# 扫描服务容器内的受控任务配置路径与受控索引目录
SCANS_TASKS_FILE=/config/scans.json
SCANS_INDEX_DIR=/app/indexes

# gdu 可执行文件路径（沿用 scripts/efu-scan.mjs 的解析方式）
EFU_GDU_BIN=/usr/local/bin/gdu

# 宿主机挂载路径示例
EFU_INDEX_DIR=./indexes
EFU_CONFIG_FILE=./deploy/config.example.json
SCANS_TASKS_FILE_HOST=./deploy/scans.example.json
# 仅挂载给 efu-scanner（只读），绝不挂载给 Web/Nginx 容器
NAS_SOURCE_DIR=/mnt/nas