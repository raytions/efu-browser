# Ignore git metadata
.git
.gitignore

# Ignore generated efu files and directories (mounted read-only at runtime)
*.efu
!demo/*.efu
efu/
indexes/

# Ignore tests, deployment templates, and docs not needed in Docker images
tests/
deploy/
docs/

# Node / Python / misc artifacts
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
__pycache__
*.pyc

# Local environment
.env
.DS_Store
.idea
.vscode

# Build and cache
coverage
.tmp
.cache
